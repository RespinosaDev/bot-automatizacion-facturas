{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Panel web (Streamlit)",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "panel.py"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Procesar facturas de datos/entrada",
      "type": "debugpy",
      "request": "launch",
      "module": "facturas",
      "args": ["procesar"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Vigilar la carpeta de entrada",
      "type": "debugpy",
      "request": "launch",
      "module": "facturas",
      "args": ["vigilar"],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Cargar facturas de ejemplo",
      "type": "debugpy",
      "request": "launch",
      "module": "facturas",
      "args": ["ejemplos"],
      "cwd": "${workspaceFolder}"
    }
  ]
}
